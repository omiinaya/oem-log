---
/**
 * oem/log <Header> — a THIN WRAPPER over the library's header.
 *
 * This file used to be a fork: a verbatim copy of
 * `oem-ui/src/astro/Header.astro` from 2026-09-30 that then drifted as the
 * library moved on. Measured 2026-10-09: 241 diff lines, and the fork's
 * only real content was
 *
 *   matchSegment={l.label === 'notes' || l.href === `${base}blog/`}
 *
 * - the library's own matcher, inlined into a private copy of the header
 * so a consumer could reach it at all. That is the exact expression
 * `src/astro/current.ts` now exists to remove: the library's <Header>
 * calls `isCurrentPage` itself, so a caller only has to say WHICH link
 * should stay lit past its own path.
 *
 * What this file owns now is nothing but oem/log's own decisions:
 *
 *   - the three destinations the blog has, and that `notes` is the
 *     section link (it stays current while you read /blog/a-note);
 *   - that the brand is THIS site's title, read from the one config the
 *     site owns (`src/astro/config.ts` - install.sh never overwrites it).
 *
 * Everything else - the burger, the row, the tap floors, the theme toggle,
 * the GitHub mark - is rendered by `../astro/Header.astro`, which is
 * vendored and re-synced. There is no <header>, no <style> block and no
 * `cm-*` class written here, because a second implementation that only
 * LOOKS like the library header is the failure mode this file existed to
 * be: the site shipped `.cm-header__link` markup that `.cm-header` CSS
 * never matched, and "in sync" read as "adopted" for a week.
 *
 * `import.meta.env.BASE_URL` is the prefix for a site served under a
 * sub-path; the GitHub mark ships WITH the link in the library, so it
 * cannot render as a zero-width box.
 */
import LibHeader from '../astro/Header.astro';
import { SITE } from '../astro/config';

const base = import.meta.env.BASE_URL ?? '/';

/* The three destinations this blog actually has, in a layout-appropriate
   order. `active` is a statement about WHERE YOU ARE - one link, the
   current page - and the library derives it from the URL rather than from
   four hand-written booleans, one per page, that drift the moment a path
   changes. `matchSegment: true` on `notes` is the escape hatch: `/blog`
   stays current while you read `/blog/a-note`, but the home and about
   links stay strict, because a section link that lights on every descendant
   is a different statement. The library keeps this apart from the
   scroll-spy's `is-active`, because on a single-page site both would be
   true of the same link at once. */
const links = [
	{ href: base, label: 'home' },
	{ href: `${base}blog/`, label: 'notes', matchSegment: true },
	{ href: `${base}about/`, label: 'about' },
];
---

{/* Spread LAST, so a page that passes `extraLinks` (every page does) wins,
    and a page that ever needs to replace the whole nav can. Nothing else is
    passed by the callers today - the nav itself is this file's job. */}
<LibHeader
	links={links}
	brand={SITE.title}
	homeHref={base}
	{...Astro.props}
/>
