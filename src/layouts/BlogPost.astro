---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostHead from '../astro/PostHead.astro';
import { SITE } from '../astro/config';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html
	lang="en"
	data-cm-theme-key="oem-log-theme"
	data-cm-theme-legacy="cm-theme"
>
	<head>
		<BaseHead title={title} description={description} />
		<!-- The theme preference lives under this project's own key (on <html>
		     above) and the library's runtime owns the toggle. Imported so Vite
		     bundles it: a raw src path is emitted verbatim and never shipped. -->
		<script>
			import '../js/cli-mono.js';
		</script>
	</head>

	<body>
		<Header extraLinks={[{ href: SITE.github, label: 'github' }]} />
		<main class="post-main">
			<article>
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				<div class="cm-prose">
					<PostHead title={title} date={pubDate} updatedDate={updatedDate} />
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero-image { margin: 1rem 0 2rem; }
	.hero-image img { display: block; width: 100%; border-radius: var(--radius-sm); border: 1px solid var(--line); }

	/* The article head is the library's <PostHead> now, not this file's.
	   This block used to re-implement it in four rules - `.post-head`,
	   `.byline`, `.sep` and `.updated` - which is the failure the
	   migration existed to remove: a second copy of surface the library
	   owns, so every fix it makes stops at the repo boundary.
	   MEASURED in WebKit at 390 and 1280 before the swap, the fork's
	   `.sep` was an ELEMENT inside a `flex-wrap: wrap` row - the exact
	   shape the library deleted when it made the footer separator
	   generated, and again for the byline. It did not strand here only
	   because no post carries `updatedDate` yet, so the row never
	   wrapped: a latent bug, not an absent one. The first post with an
	   `updatedDate` would have stranded a dot at every phone width.
	   `.cm-post-head`, `.cm-byline`, the `## ` heading marks and the
	   mobile prose bumps all come from cli-mono/components.css, and
	   the `--head-*`/`--space-*` rhythm from its tokens. */

	/* `.cm-prose` is the library's reading column; this file used to
	   re-declare its body colour and font-size at `--ink`/0.95rem,
	   against the library's own `--ink`/var(--text). Nothing about the
	   look changes - only who owns the number. */

	/* The link colour and the `## ` h2 mark were re-declared here long
	   after components.css shipped the identical pair; they are the
	   library's now, so a fix to prose links reaches this page too. */
</style>