---
/*
 * oem-ui <Footer> — the library's footer, not a parallel implementation.
 *
 * Migrated to use the library's Footer: the meta row's separator bug and the
 * status row's wrapping are both solved by the library's ::before pairing.
 */
import Footer from '../astro/Footer.astro';
import { SITE } from './config';
---
<Footer
	items={['build with astro', 'static', 'no tracking']}
	contactHref={`mailto:${SITE.email}`}
	status={[
		'all systems nominal',
		'sig: posts publish from origin only',
	]}
/>