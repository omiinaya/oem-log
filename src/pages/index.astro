---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { SITE } from '../components/config';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 4);
---

<!doctype html>
<html
	lang="en"
	data-cm-theme-key="oem-log-theme"
	data-cm-theme-legacy="cm-theme"
>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<!-- The theme preference lives under this project's own key (on <html>
		     above) and the library's runtime owns the toggle. Imported so Vite
		     bundles it: a raw src path is emitted verbatim and never shipped. -->
		<script>
			import '../js/cli-mono.js';
		</script>
	</head>
	<body>
		<Header extraLinks={[{ href: SITE.github, label: 'github' }]} />
		<!-- The vertical rhythm: `.cm-stack` owns the space BETWEEN the
		     blocks on this page. Measured before: the head block sat
		     flush against the content below it at exactly 0.0px, because
		     `.cm-head` set no bottom margin and nothing else owned the
		     gap - so every project invented its own number and none of
		     them matched. Override `--stack-section` once on :root to
		     retune every gap on the site at once. -->
		<main class="cm-stack cm-stack--section">
			<!--
				Every block below is a library component. This page used to
				maintain a second implementation of all of them - `.hero`,
				`.hero-title`, `.hero-desc`, `.btn-primary`, `.status`/`.lbl`/
				`.val`, `.list-head`, `.post-list` and its nine parts - in a
				scoped block, in a file the library has owned since the
				migration. A local copy is a second owner for a rule the
				design system owns, so a library fix never reaches this page
				and the two drift. That is the whole reason the layers exist.
				The one genuinely local thing left is the phone breakpoint
				that hides the description and the date, and it now comes
				from the library: `.cm-rows--inline` opts into exactly the
				rule this page used to re-declare locally, so the file has
				no scoped block at all. That is the point of the migration —
				the page no longer owns a second copy of anything.
			-->
			<section class="cm-head">
				<p class="cm-kicker">things we learned · worth sharing</p>
				<h1>{SITE_TITLE}</h1>
				<p class="cm-lede">
					Short writeups of things we've learned while shipping real systems:
					the reusable trick, the gotcha that cost us time, and how to use it
					in a bigger build. No full blueprints, no sensitive details, just the
					useful middle of the story.
				</p>
				<div class="cm-btn-group">
					<a class="cm-btn" href={`${import.meta.env.BASE_URL}blog/`}>&gt;_ read the notes</a>
				</div>
			</section>

			<div class="cm-status cm-status--ok">
				<span class="cm-status__label">status</span>
				<span class="cm-status__value">static · fast · zero runtime attack surface</span>
			</div>

			{latest.length > 0 && (
				<section>
					<div class="cm-list-head">Index / latest</div>
					<ul class="cm-rows cm-rows--inline">
						{
							latest.map((post, i) => (
								<li>
									<a class="cm-row" href={`${import.meta.env.BASE_URL}blog/${post.id}/`}>
										<span class="cm-row__idx">{String(posts.length - i).padStart(2, '0')}</span>
										<span class="cm-row__body">
											<span class="cm-row__title">{post.data.title}</span>
											<span class="cm-row__desc">{post.data.description}</span>
										</span>
										<span class="cm-row__meta">
											<FormattedDate date={post.data.pubDate} />
										</span>
										<span class="cm-row__sym" aria-hidden="true">▸</span>
									</a>
								</li>
							))
						}
					</ul>
					<div class="cm-list-more">
						<a href={`${import.meta.env.BASE_URL}blog/`}>$ cat all →</a>
					</div>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>
