---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { SITE } from '../../components/config';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html
	lang="en"
	data-cm-theme-key="oem-log-theme"
	data-cm-theme-legacy="cm-theme"
>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<!-- The theme preference lives under this project's own key (on <html>
		     above) and the library's runtime owns the toggle. Imported so Vite
		     bundles it: a raw src path is emitted verbatim and never shipped. -->
		<script>
			import '../../js/cli-mono.js';
		</script>
	</head>
	<body>
		<Header extraLinks={[{ href: SITE.github, label: 'github' }]} />
		<main>
			<!--
				Library components, as on the home page. This page used to own
				a second copy of `.cm-head` (as `.list-head`) and a second
				copy of the row list (as `.post-grid` and its seven parts) in
				a scoped block. The stacked variant is the library's, not
				this page's: `.cm-rows--stacked` already declares the
				column body, the larger title and the spacing between
				title / description / date that this page had re-derived.
			-->
			<section class="cm-head">
				<p class="cm-kicker">all notes</p>
				<h1>Index</h1>
				<p class="cm-head__sub">{posts.length} note{posts.length === 1 ? '' : 's'} · newest first</p>
			</section>

			<ul class="cm-rows cm-rows--stacked">
				{
					posts.map((post, i) => (
						<li>
							<a class="cm-row" href={`${import.meta.env.BASE_URL}blog/${post.id}/`}>
								<span class="cm-row__idx">{String(posts.length - i).padStart(2, '0')}</span>
								<span class="cm-row__body">
									<span class="cm-row__title">{post.data.title}</span>
									<span class="cm-row__desc">{post.data.description}</span>
									<span class="cm-row__meta">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</span>
								<span class="cm-row__sym" aria-hidden="true">▸</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* The date is the third line in this row, not a trailing column, so it
	   has to sit below the description rather than beside it. The stacked
	   variant orders title / desc / meta vertically and adds the top margin
	   on each; the library's `.cm-row__meta` is a bare column by default and
	   would sit on the title's baseline. This is the one genuinely local
	   declaration the migration left, and it is a PLACEMENT fix, not a
	   re-implementation: colour, size and the row's own box all still come
	   from the library.

	   FormattedDate renders a bare <time> element, so a font-size on this
	   element is only an inherited default - the child resolved to 11.52px
	   on a phone before. Target the element that carries the text. */
	.cm-rows--stacked .cm-row__meta :global(time) {
		font-size: max(var(--min-font), 0.72rem);
	}
</style>
