---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname.replace(base, '').replace(/\/$/, '');
// normalize the href to a base-relative path for comparison
const target = (href.startsWith(base) ? href.slice(base.length) : href)
	.split('?')[0]
	.replace(/\/$/, '');
const segment = pathname.split('/')[0];
const isActive = target === '' ? pathname === '' : target === pathname || target === segment;
const activeClass = isActive ? 'nav-active' : '';
---

<a href={href} class:list={[className, activeClass]} {...props}>
	<slot />
</a>